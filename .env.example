# ==============================================================================
# Bharat Intelli Tech Systems - Environment Configuration
# ==============================================================================

# Contact Form Backend Endpoint (Optional)
# If provided, form submissions will POST JSON to this endpoint.
# If omitted or empty, the frontend runs in development simulation mode.
VITE_CONTACT_API_URL=https://api.bharatintellitech.com/v1/inquiries

# EmailJS Integration (Optional alternative to backend endpoint)
# VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
# VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
# VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Google Analytics / Measurement ID (Optional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Production Domain
VITE_SITE_URL=https://bharatintellitech.com
